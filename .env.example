# Copy to .env. The installer generates all required secrets automatically.
APP_PORT=8095
APP_BIND=0.0.0.0
TZ=Europe/Berlin
COOKIE_SECURE=0
SESSION_DAYS=30
AUTOMATIC_REVALUE_HOUR=3

POSTGRES_DB=gamecollector
POSTGRES_USER=gamecollector
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_VOLUME_NAME=gamecollector_postgres_data
SECRET_KEY=CHANGE_ME

# Created only on a fresh database. The public bootstrap login must be changed.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_FORCE_PASSWORD_CHANGE=1

# Optional metadata provider.
RAWG_API_KEY=

# eBay credentials can be entered later in the administration interface.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_DEV_ID=
EBAY_MARKETPLACE=EBAY_DE
EBAY_ENVIRONMENT=production
