POSTGRES_DB=gamecollector
POSTGRES_USER=gamecollector
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
APP_PORT=8095

# v0.3.3: Optionaler zusätzlicher Provider. Standardmäßig werden
# UPCitemdb (kostenlose Trial-API) und BarcodeFinder als Fallback genutzt.
BARCODE_LOOKUP_URL=

# Optional, empfohlen für die breite Titel-/Metadatensuche nach Barcode-Fehlschlag.
# Kostenlosen Hobby-Key bei RAWG anlegen und hier eintragen.
RAWG_API_KEY=

# Optional: aktuelle Sammlerwerte (Loose/CIB/New usw.).
# PriceCharting API ist kostenpflichtig; Token niemals in Chats posten.
PRICECHARTING_TOKEN=

# Optional: zweite kostenlose/legitime Preisquelle für viele Retro-Systeme.
# Persönlichen Auth-Code laut VGPreise API-Dokumentation direkt bei VGPreise anfragen.
VGPREISE_AUTH_CODE=

# v0.7.2 automatic valuation
TZ=Europe/Berlin
AUTOMATIC_REVALUE_HOUR=3
