{% extends 'base.html' %}
{% block title %}Reihen & Sammlungen · Collector{% endblock %}
{% block content %}
<section class="collector-section-hero"><a class="collector-back" href="{{ url_for('collector_home') }}">← Collector-Startseite</a><span class="collector-section-icon">🗂️</span><span class="eyebrow">Collector</span><h1>Reihen &amp; Sammlungen</h1><p>Spielreihen, TV-Serien, Buch- und Filmreihen sowie Konsolenfamilien auf einen Blick.</p></section>
<section class="panel"><div class="collector-actions"><a class="button" href="{{ url_for('collector_collections', type='all') }}">Alle</a><a class="button" href="{{ url_for('collector_collections', type='games') }}">🎮 Spielreihen</a><a class="button" href="{{ url_for('collector_collections', type='books') }}">📚 Buchreihen</a><a class="button" href="{{ url_for('collector_collections', type='tv') }}">📺 TV-Serien</a><a class="button" href="{{ url_for('collector_collections', type='movies') }}">🎬 Filmreihen</a><a class="button" href="{{ url_for('collector_collections', type='consoles') }}">🕹️ Konsolen</a></div></section>
{% if groups %}<section class="collector-item-list">{% for group in groups %}<article class="panel"><div class="page-head"><div><span class="eyebrow">{{ group.icon }} {{ group.label }}</span><h2>{{ group.name }}</h2><p class="muted">{{ group.items|length }} Teile · {{ eur(group.value) }} Sammlungswert</p></div></div><div class="collector-item-list">{% for item in group.items %}<div class="collector-item-row">{% if item.cover %}<img src="{{ item.cover }}" alt="" loading="lazy">{% endif %}<div><strong>{% if item.order %}{{ item.order }} · {% endif %}<a href="{{ item.url }}">{{ item.title }}</a></strong><p class="muted">{{ item.subtitle }}</p></div><strong>{{ eur(item.value) }}</strong></div>{% endfor %}</div></article>{% endfor %}</section>{% else %}<section class="panel"><strong>Noch keine Reihen oder Sammlungen erkannt.</strong><p class="muted">TV-Staffeln werden nach Serie gruppiert; Buch- und Filmreihen können automatisch oder manuell zugeordnet werden. Spielreihen und Konsolenfamilien bleiben ebenfalls sichtbar.</p></section>{% endif %}
{% endblock %}
