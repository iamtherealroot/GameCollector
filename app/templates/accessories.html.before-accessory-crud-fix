{% extends 'base.html' %}{% block title %}Zubehör · GameCollector{% endblock %}{% block content %}
<div class="page-head"><div><span class="eyebrow">Hardware Collection</span><h1>Zubehör</h1><p class="muted">Controller, Memory Cards, Adapter, Kameras und weiteres Zubehör verwalten und bewerten.</p></div><div class="page-actions"><form method="post" action="{{ url_for('accessories_revalue_all') }}"><button data-disable-on-submit>↻ Unbewertetes Zubehör bewerten</button></form><a class="button secondary-link" href="{{ url_for('hardware') }}">Konsolen</a></div></div>
<div class="split"><section><h2>Zubehör hinzufügen</h2><form method="post" class="panel" enctype="multipart/form-data"><label>Name<input name="name" required placeholder="DualShock 2"></label><label>Konsole<select name="console_id"><option value="">Keine feste Zuordnung</option>{% for c in consoles %}<option value="{{ c.id }}">{{ c.name }}</option>{% endfor %}</select></label><div class="row"><label>Hersteller<input name="manufacturer"></label><label>Modellnummer<input name="model_number"></label></div><div class="row"><label>Farbe<input name="color"></label><label>Anzahl<input name="quantity" type="number" min="1" value="1"></label></div><label>Status<select name="status"><option value="owned">Im Besitz</option><option value="wishlist">Wunschliste</option></select></label><div class="row"><label>Zustand<input name="condition" type="number" min="1" max="10" value="8"></label><label class="check"><input type="checkbox" name="boxed" value="1"> OVP vorhanden</label></div><div class="row"><label>Kaufpreis<input name="purchase_price" inputmode="decimal"></label><label>Schätzwert<input name="estimated_value" inputmode="decimal"></label></div><label>Lagerplatz<input name="storage_location"></label><label>Referenzbild-URL <small>(optional)</small><input name="reference_image" type="text"></label><label>Eigenes Foto<input type="file" name="photo" accept="image/*"></label><label>Notizen<textarea name="notes" rows="3"></textarea></label><button>Speichern</button></form></section>
<section><h2>Bestand</h2><div class="compact-list">{% for i in items %}<article class="panel accessory-row">{% if i.photo %}<img src="{{ url_for('static', filename=i.photo) }}" alt="Eigenes Foto">{% elif i.reference_image %}<img src="{{ i.reference_image }}" alt="">{% endif %}<div class="accessory-value-body"><strong>{{ i.quantity }}× {{ i.name }}</strong><span>{{ i.console.name if i.console else 'Universal' }}{% if i.model_number %} · {{ i.model_number }}{% endif %}</span><small>{% if i.status=='wishlist' %}Wunschliste{% else %}Im Besitz{% endif %} · Zustand {{ i.condition }}/10</small>{% if effective_value(i) is not none %}<div class="hardware-catalog-value"><span><small>Wert je Stück</small><strong>{{ eur(effective_value(i)) }}</strong></span><span><small>Gesamtwert</small><strong>{{ eur(effective_value(i) * (i.quantity or 1)) }}</strong></span></div><small>{{ effective_value_source(i) }}{% if i.auto_value_updated_at and i.auto_value_eur is not none %} · {{ i.auto_value_updated_at|localdt }}{% endif %}</small>{% endif %}{% if i.auto_value_message %}<small>{{ i.auto_value_message }}</small>{% endif %}<form method="post" action="{{ url_for('accessory_item_value', item_id=i.id) }}"><button class="compact-button">↻ Jetzt neu bewerten</button></form></div></article>{% else %}<div class="empty-state">Noch kein Zubehör erfasst.</div>{% endfor %}</div></section></div>
{% endblock %}
